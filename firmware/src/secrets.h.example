/**
 * @file secrets.h.example
 * @brief Template for Wi-Fi credentials and EMS server configuration.
 *
 * Copy this file to secrets.h and populate with production credentials.
 * secrets.h is excluded from git version control.
 */

#pragma once

#define WIFI_SSID "YOUR_WLAN_SSID"
#define WIFI_PASSWORD "YOUR_WLAN_PASSWORD"
#define EMS_API_BASE_URL "https://ems.local:8000"
#define EMS_API_KEY "" // Optional API key header: X-API-Key
#define EMS_MQTT_BROKER "ems.local"
#define EMS_MQTT_PORT 8883 // MQTTS with TLS
